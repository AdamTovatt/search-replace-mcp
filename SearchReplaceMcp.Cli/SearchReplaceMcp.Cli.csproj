<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SearchReplaceMcp.Core\SearchReplaceMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="0.5.0-preview.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sr</ToolCommandName>
    <PackageOutputPath>./bin/nupkg</PackageOutputPath>
    <PackageId>SearchReplaceMcp</PackageId>
    <Version>1.1.0</Version>
    <Authors>Adam Tovatt</Authors>
    <Description>A search-and-replace tool that stages and executes replacements safely. Works as both a CLI tool and MCP server.</Description>
    <PackageTags>mcp;search-replace;cli-tool;search;replace;search-and-replace;mcp-server;claude-code;</PackageTags>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>SearchReplaceMcp</Title>
    <Product>SearchReplaceMcp</Product>
    <Copyright>MIT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AdamTovatt/search-replace-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamTovatt/search-replace-mcp</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
